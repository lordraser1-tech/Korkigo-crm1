// KorkiGO CRM — schemat bazy danych (Faza 1: fundament)
// Baza: PostgreSQL. ORM: Prisma.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- KONTA I ROLE ----------

enum Role {
  ADMIN
  TEACHER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teacherProfile TeacherProfile?
  sentMessages   Message[]

  @@map("users")
}

// ---------- NAUCZYCIELE ----------

model TeacherProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName     String
  lastName      String
  phone         String?
  level         String? // np. "C1", uprawnienia/certyfikaty
  ratePerLesson Decimal @db.Decimal(10, 2) // stawka WYPŁACANA nauczycielowi — ustala tylko admin

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students       Student[]
  lessons        Lesson[]
  availabilities Availability[]
  messages       MessageRecipient[]

  @@map("teacher_profiles")
}

// Dyspozycyjność — powtarzalne okna czasowe (grafik dyspozycji)
model Availability {
  id        String         @id @default(cuid())
  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  dayOfWeek Int // 0 = niedziela ... 6 = sobota
  startTime String // "16:00"
  endTime   String // "20:00"

  @@map("availabilities")
}

// ---------- UCZNIOWIE ----------

enum StudentStatus {
  ACTIVE
  PAUSED
  ENDED
}

model Student {
  id String @id @default(cuid())

  firstName    String
  lastName     String
  contactEmail String?
  contactPhone String?

  // Dane rodzica/opiekuna (jeśli niepełnoletni)
  parentName  String?
  parentPhone String?
  parentEmail String?

  languageLevel String? // np. "A2"
  subject       String? // np. "Polski ogólny", "Polski maturalny"
  ratePerLesson Decimal @db.Decimal(10, 2) // stawka PŁACONA przez ucznia — NIGDY nie zwracaj w API dla roli TEACHER

  status      StudentStatus @default(ACTIVE)
  billingMode BillingMode   @default(POSTPAID) // jak ten uczeń płaci

  teacherId String?
  teacher   TeacherProfile? @relation(fields: [teacherId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessons       Lesson[]
  notes         LessonNote[]
  knowledgeBase KnowledgeBaseEntry[]
  invoices      Invoice[]
  payments      Payment[]

  @@map("students")
}

// ---------- KALENDARZ LEKCJI ----------

enum LessonType {
  RECURRING
  ONE_OFF
}

enum LessonStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Lesson {
  id String @id @default(cuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id])

  scheduledAt     DateTime
  durationMinutes Int      @default(60)

  type     LessonType
  seriesId String? // wspólny identyfikator dla lekcji cyklicznych z jednego wzorca
  status   LessonStatus @default(SCHEDULED)

  /// Temat zajęć wpisywany przez nauczyciela przy samej lekcji (krótka notka).
  /// Pełny szablon notatki (co było / jak poszło / cel / co dalej) to osobny
  /// model `LessonNote` z fazy 2.
  topic String?

  googleEventId String? // zarezerwowane pod przyszłą synchronizację z Google Calendar

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  note        LessonNote?
  invoiceItem InvoiceItem? // lekcja może trafić tylko na jeden rachunek

  @@map("lessons")
}

// ---------- NOTATKI Z LEKCJI ----------
// Szablon: co było / jak poszło / jaki cel / co dalej

model LessonNote {
  id        String  @id @default(cuid())
  lessonId  String  @unique
  lesson    Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  whatWeDid String @db.Text
  howItWent String @db.Text
  goal      String @db.Text
  nextSteps String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("lesson_notes")
}

// ---------- BAZA WIEDZY (per uczeń) ----------

model KnowledgeBaseEntry {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  title   String
  content String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("knowledge_base_entries")
}

// ---------- PŁATNOŚCI I RACHUNKI (Faza 2) ----------

enum BillingMode {
  POSTPAID // rachunek na koniec miesiąca za lekcje zrealizowane
  PER_LESSON // rachunek po każdej zrealizowanej lekcji
  PREPAID // pakiet opłacany z góry, lekcje zdejmują jednostki z pakietu
}

enum InvoiceStatus {
  ISSUED
  CANCELLED
}

// Rachunek (działalność nierejestrowana — nie faktura VAT).
// Numer nadawany automatycznie: "1/09/2026", numeracja resetuje się co miesiąc.
model Invoice {
  id          String @id @default(cuid())
  number      String @unique
  numberYear  Int
  numberMonth Int
  sequence    Int

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  issuedAt DateTime      @default(now())
  dueAt    DateTime
  status   InvoiceStatus @default(ISSUED)

  // Okres, którego dotyczy rachunek (puste dla pakietu przedpłaconego)
  periodStart DateTime?
  periodEnd   DateTime?

  totalAmount Decimal @db.Decimal(10, 2)
  note        String?

  // Dane wystawcy skopiowane w chwili wystawienia — wydruk ma być niezmienny
  sellerSnapshot String? @db.Text
  buyerSnapshot  String? @db.Text

  items    InvoiceItem[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([numberYear, numberMonth, sequence])
  @@index([studentId])
  @@map("invoices")
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(10, 2)
  amount      Decimal @db.Decimal(10, 2)

  // Powiązanie z lekcją pilnuje, by ta sama lekcja nie trafiła na dwa rachunki
  lessonId String? @unique
  lesson   Lesson? @relation(fields: [lessonId], references: [id])

  @@index([invoiceId])
  @@map("invoice_items")
}

enum PaymentMethod {
  TRANSFER
  CASH
  BLIK
  OTHER
}

model Payment {
  id String @id @default(cuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  // Wpłata bez rachunku to przedpłata na poczet przyszłych lekcji
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  amount Decimal       @db.Decimal(10, 2)
  paidAt DateTime      @default(now())
  method PaymentMethod @default(TRANSFER)
  note   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([invoiceId])
  @@map("payments")
}

// Dane wystawcy na rachunku + domyślny termin płatności. Jeden rekord.
model BillingSettings {
  id              String   @id @default("singleton")
  sellerName      String   @default("")
  sellerAddress   String   @default("")
  sellerContact   String   @default("")
  sellerTaxNote   String   @default("Sprzedaż nieewidencjonowana — działalność nierejestrowana.")
  bankAccount     String   @default("")
  paymentTermDays Int      @default(7)
  invoiceFooter   String   @default("")
  updatedAt       DateTime @updatedAt

  @@map("billing_settings")
}

// ---------- DZIAŁALNOŚĆ NIEREJESTROWANA — LIMIT I STATYSTYKI (Faza 3) ----------

enum NdgPeriodMode {
  MONTHLY // limit rozliczany miesiąc po miesiącu
  QUARTERLY // limit rozliczany kwartalnie
}

enum NdgRevenueBasis {
  INVOICED // przychód należny — liczony z wystawionych rachunków
  PAID // ujęcie kasowe — liczone z wpłat
}

/// Ustawienia modułu NDG. Jeden rekord.
/// `enabled = false` wyłącza pilnowanie limitu (np. po założeniu firmy) —
/// moduł zostaje wtedy jako czyste statystyki finansowe.
model NdgSettings {
  id                   String          @id @default("singleton")
  enabled              Boolean         @default(true)
  mode                 NdgPeriodMode   @default(QUARTERLY)
  revenueBasis         NdgRevenueBasis @default(INVOICED)
  /// Próg ostrzeżenia w procentach limitu okresu.
  warnThresholdPercent Int             @default(90)
  /// Data przejścia na działalność rejestrowaną — dokumentuje, od kiedy limitu nie liczymy.
  businessStartedAt    DateTime?
  note                 String          @default("")
  updatedAt            DateTime        @updatedAt

  @@map("ndg_settings")
}

/// Limit miesięczny obowiązujący od podanej daty. Trzymamy historię, bo kwota
/// zmienia się razem z minimalnym wynagrodzeniem — limit kwartału to suma
/// limitów jego miesięcy.
///
/// UWAGA: kwoty wprowadza administrator. Aplikacja nie zna przepisów i nie
/// jest doradcą podatkowym — wartości potwierdź z księgowym.
model NdgMonthlyLimit {
  id        String   @id @default(cuid())
  validFrom DateTime @unique
  amount    Decimal  @db.Decimal(10, 2)
  note      String   @default("")
  createdAt DateTime @default(now())

  @@map("ndg_monthly_limits")
}

// ---------- WIADOMOŚCI (admin -> nauczyciele) ----------

/// Wiadomość wysyłana przez administratora: do jednego nauczyciela albo do
/// wszystkich. Stan przeczytania trzyma `MessageRecipient`, osobno dla każdego
/// odbiorcy — dzięki temu wysyłka zbiorcza działa tak samo jak pojedyncza.
model Message {
  id String @id @default(cuid())

  senderId String
  sender   User   @relation(fields: [senderId], references: [id])

  subject   String
  body      String  @db.Text
  /// true = wysłana do wszystkich aktywnych nauczycieli w chwili wysyłki
  broadcast Boolean @default(false)

  createdAt DateTime @default(now())

  recipients MessageRecipient[]

  @@index([createdAt])
  @@map("messages")
}

model MessageRecipient {
  id String @id @default(cuid())

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  readAt DateTime?

  @@unique([messageId, teacherId])
  @@index([teacherId, readAt])
  @@map("message_recipients")
}

// ---------- ZAREZERWOWANE NA KOLEJNE FAZY ----------
// Faza 3 (dalej): eksport ewidencji do PIT-36, automatyczne wezwania do zapłaty
// Faza 4: wsparcie AI przy notatkach — nie wymaga zmian w schemacie, tylko w warstwie aplikacji
