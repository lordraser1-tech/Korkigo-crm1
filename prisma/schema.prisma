// KorkiGO CRM — schemat bazy danych (Faza 1: fundament)
// Baza: PostgreSQL. ORM: Prisma.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- KONTA I ROLE ----------

enum Role {
  ADMIN
  TEACHER
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  role         Role

  /// Sesje wydane PRZED tą chwilą są nieważne. Ustawiamy ją przy każdej
  /// zmianie hasła, żeby wykradzione ciasteczko przestawało działać —
  /// bez tego token żyłby do wygaśnięcia mimo zmienionego hasła.

  /// Ochrona przed zgadywaniem hasła. Licznik zeruje się po udanym logowaniu,
  /// a blokada jest KRÓTKA i tylko czasowa — trwałe zamknięcie konta dałoby
  /// się wykorzystać do odcięcia nauczyciela od pracy cudzymi próbami.

  /// Sekret TOTP (drugi składnik). Trzymany ZASZYFROWANY — wyciek bazy nie
  /// może dać komuś generatora kodów. `null` = drugi składnik wyłączony.
  totpSecret        String?
  /// Od kiedy drugi składnik jest wymagany przy logowaniu.
  totpEnabledAt     DateTime?
  failedLogins      Int       @default(0)
  lockedUntil       DateTime?
  sessionsValidFrom DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  teacherProfile TeacherProfile?
  sentMessages   Message[]
  speakingClubs  SpeakingClubUse[]
  payouts        Payout[]
  securityEvents SecurityEvent[]
  recoveryCodes  TwoFactorRecoveryCode[]

  @@map("users")
}

// ---------- NAUCZYCIELE ----------

model TeacherProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String
  phone     String?
  level     String? // np. "C1", uprawnienia/certyfikaty

  /// Numer konta do wypłat. Widzi go właściciel konta i admin — nikt inny.
  bankAccount String?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students       Student[]
  lessons        Lesson[]
  availabilities AvailabilitySlot[]
  messages       MessageRecipient[]
  rates          TeacherRate[]
  payouts        Payout[]
  googleCalendar GoogleCalendarLink?

  @@map("teacher_profiles")
}

/// Dyspozycyjność na KONKRETNY dzień (nie wzorzec tygodniowy).
/// Kopiowanie na kolejne dni robi warstwa aplikacji, nie schemat.
model AvailabilitySlot {
  id        String         @id @default(cuid())
  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  /// Konkretny dzień — północ czasu warszawskiego (konwersja w `datetime.ts`).
  date      DateTime
  startTime String // "16:00"
  endTime   String // "20:00"

  createdAt DateTime @default(now())

  @@unique([teacherId, date, startTime])
  @@index([teacherId, date])
  @@map("availability_slots")
}

// ---------- UCZNIOWIE ----------

enum StudentStatus {
  ACTIVE
  PAUSED
  ENDED
}

model Student {
  id String @id @default(cuid())

  firstName        String
  lastName         String
  contactEmail     String?
  contactPhone     String?
  contactInstagram String?
  contactTelegram  String?

  /// Stały link do pokoju (Google Meet / Zoom). Widoczny też dla nauczyciela —
  /// to nie jest kwota, więc nie łamie zasady ukrywania cen.
  meetingLink String?

  /// Ustawiany automatycznie po połączeniu konta przez bota; nigdy ręcznie.
  telegramChatId  String?         @unique
  reminderChannel ReminderChannel @default(NONE)

  // Dane rodzica/opiekuna (jeśli niepełnoletni)
  parentName  String?
  parentPhone String?
  parentEmail String?

  languageLevel String? // np. "A2" — poziom językowy ucznia, opisowy

  status      StudentStatus @default(ACTIVE)
  billingMode BillingMode   @default(POSTPAID) // jak ten uczeń płaci

  teacherId String?
  teacher   TeacherProfile? @relation(fields: [teacherId], references: [id])

  /// Kiedy dane osobowe ucznia zostały nadpisane na żądanie (RODO art. 17).
  /// Rekordy finansowe zostają — mają własny okres przechowywania — ale nie
  /// wskazują już na konkretną osobę.
  anonymizedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  lessons        Lesson[]
  notes          LessonNote[]
  invoices       Invoice[]
  payments       Payment[]
  rates          StudentRate[]
  speakingClubs  SpeakingClubUse[]
  telegramTokens TelegramLinkToken[]

  @@map("students")
}

// ---------- PRZEDMIOTY, POZIOMY I STAWKI ----------

/// Przedmiot (np. „Polski”, „Matematyka”). Listę tworzy admin.
model Subject {
  id     String  @id @default(cuid())
  name   String  @unique
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  levels        SubjectLevel[]
  knowledgeBase KnowledgeBaseEntry[]

  @@map("subjects")
}

/// Poziom w ramach przedmiotu (np. „Podstawowy”, „Maturalny”).
/// Liczba poziomów jest dowolna — nie ma sztywnej listy.
model SubjectLevel {
  id        String  @id @default(cuid())
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name      String
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessons      Lesson[]
  teacherRates TeacherRate[]
  studentRates StudentRate[]

  @@unique([subjectId, name])
  @@map("subject_levels")
}

/// Stawka WYPŁACANA nauczycielowi za lekcję z danego przedmiotu/poziomu.
/// Ustala wyłącznie admin.
model TeacherRate {
  id             String         @id @default(cuid())
  teacherId      String
  teacher        TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subjectLevelId String
  subjectLevel   SubjectLevel   @relation(fields: [subjectLevelId], references: [id], onDelete: Cascade)

  amount Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teacherId, subjectLevelId])
  @@map("teacher_rates")
}

/// Cena PŁACONA przez ucznia za lekcję z danego przedmiotu/poziomu —
/// indywidualna dla każdego ucznia. NIGDY nie zwracaj jej w API dla roli TEACHER.
model StudentRate {
  id             String       @id @default(cuid())
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectLevelId String
  subjectLevel   SubjectLevel @relation(fields: [subjectLevelId], references: [id], onDelete: Cascade)

  amount Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, subjectLevelId])
  @@map("student_rates")
}

/// Wykorzystany darmowy Speaking Club. Liczba przysługujących wynika
/// z liczby lekcji zrealizowanych; ten model zapisuje zużycia.
model SpeakingClubUse {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  usedAt     DateTime @default(now())
  markedById String
  markedBy   User     @relation(fields: [markedById], references: [id])
  note       String?

  createdAt DateTime @default(now())

  @@index([studentId])
  @@map("speaking_club_uses")
}

// ---------- KALENDARZ LEKCJI ----------

enum LessonType {
  RECURRING
  ONE_OFF
}

enum LessonStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Lesson {
  id String @id @default(cuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id])

  subjectLevelId String
  subjectLevel   SubjectLevel @relation(fields: [subjectLevelId], references: [id])

  scheduledAt     DateTime
  durationMinutes Int      @default(60)

  type     LessonType
  seriesId String? // wspólny identyfikator dla lekcji cyklicznych z jednego wzorca
  status   LessonStatus @default(SCHEDULED)

  /// Temat zajęć wpisywany przez nauczyciela przy samej lekcji (krótka notka).
  /// Pełny szablon notatki (co było / jak poszło / cel / co dalej) to osobny
  /// model `LessonNote` z fazy 2.
  topic String?

  /// Kiedy uczeń ZGŁOSIŁ odwołanie (nie kiedy kliknięto w systemie) — od tego
  /// liczy się próg 24h/12h z regulaminu.
  cancelledReportedAt    DateTime?
  /// Kwota wynikająca z regulaminu (do audytu korekt).
  cancellationAutoAmount Decimal?  @db.Decimal(10, 2)
  /// Kwota faktycznie naliczona uczniowi (po ewentualnej korekcie admina).
  cancellationAmount     Decimal?  @db.Decimal(10, 2)
  /// Powód korekty — wymagany, gdy kwota różni się od wyliczonej.
  cancellationNote       String?

  /// Lekcja odczepiona od serii edycją „tylko ta” — zbiorcze zmiany jej nie ruszają.
  detachedFromSeries Boolean @default(false)

  /// W której wypłacie lekcja została rozliczona z nauczycielem.
  teacherPayoutId String?
  teacherPayout   Payout? @relation(fields: [teacherPayoutId], references: [id])

  /// Zdarzenie w kalendarzu Google nauczyciela, jeśli lekcja tam poszła.
  googleEventId String?

  /// Kiedy lekcja została wypchnięta do Google. `null` albo wartość starsza
  /// niż `updatedAt` oznacza, że zmiana czeka na wysłanie — stąd cron wie,
  /// co dosłać, bez osobnej kolejki.
  googleSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  note        LessonNote?
  invoiceItem InvoiceItem? // lekcja może trafić tylko na jeden rachunek
  reminders   ReminderLog[]

  @@index([googleSyncedAt])
  @@map("lessons")
}

// ---------- SYNCHRONIZACJA Z GOOGLE CALENDAR ----------
// Jednokierunkowo: CRM jest źródłem prawdy, Google tylko odzwierciedla grafik.
// Każdy nauczyciel podłącza WŁASNE konto i widzi wyłącznie swoje lekcje.

/// Połączenie konta Google jednego nauczyciela.
///
/// `refreshToken` to sekret — trzymamy go, bo bez niego nie da się odświeżyć
/// dostępu, ale nie opuszcza on serwera i nie trafia do żadnego DTO.
model GoogleCalendarLink {
  id        String         @id @default(cuid())
  teacherId String         @unique
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  /// Adres konta Google — pokazujemy go, żeby było widać, co jest podłączone.
  googleEmail String
  /// Kalendarz docelowy; "primary" to główny kalendarz konta.
  calendarId  String @default("primary")

  refreshToken String
  accessToken  String?
  /// Do kiedy `accessToken` jest ważny; po tym czasie odświeżamy go sami.
  expiresAt    DateTime?

  /// Wyłączenie bez rozłączania konta — lekcje przestają się wypychać.
  enabled Boolean @default(true)

  lastSyncAt    DateTime?
  lastSyncError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("google_calendar_links")
}

/// Nagrobek po lekcji usuniętej z CRM-a.
///
/// Po usunięciu wiersza lekcji nie ma już skąd wziąć `googleEventId`, więc
/// zapisujemy go tutaj i cron dokańcza usunięcie zdarzenia w Google.
model GoogleCalendarDeletion {
  id            String @id @default(cuid())
  teacherId     String
  googleEventId String
  calendarId    String @default("primary")

  attempts  Int      @default(0)
  lastError String?
  createdAt DateTime @default(now())

  @@index([teacherId])
  @@map("google_calendar_deletions")
}

// ---------- NOTATKI Z LEKCJI ----------
// Szablon: co było / jak poszło / jaki cel / co dalej

model LessonNote {
  id        String  @id @default(cuid())
  lessonId  String  @unique
  lesson    Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  whatWeDid String @db.Text
  howItWent String @db.Text
  goal      String @db.Text
  nextSteps String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("lesson_notes")
}

// ---------- BAZA WIEDZY (per uczeń) ----------

/// Materiał pomocniczy przypięty do PRZEDMIOTU (nie do ucznia): podręcznik,
/// zestaw ćwiczeń, kanał na YouTube. Dodaje wyłącznie admin; nauczyciel czyta
/// materiały tych przedmiotów, do których ma stawkę (`TeacherRate`).
model KnowledgeBaseEntry {
  id        String  @id @default(cuid())
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  title       String
  /// Wyłącznie http(s) — patrz `linkUrl` w validation.ts.
  url         String
  description String @default("") @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subjectId])
  @@map("knowledge_base_entries")
}

// ---------- PŁATNOŚCI I RACHUNKI (Faza 2) ----------

enum BillingMode {
  POSTPAID // rachunek na koniec miesiąca za lekcje zrealizowane
  PER_LESSON // rachunek po każdej zrealizowanej lekcji
  PREPAID // pakiet opłacany z góry, lekcje zdejmują jednostki z pakietu
}

enum InvoiceStatus {
  ISSUED
  CANCELLED
}

// Rachunek (działalność nierejestrowana — nie faktura VAT).
// Numer nadawany automatycznie: "1/09/2026", numeracja resetuje się co miesiąc.
model Invoice {
  id          String @id @default(cuid())
  number      String @unique
  numberYear  Int
  numberMonth Int
  sequence    Int

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  issuedAt DateTime      @default(now())
  dueAt    DateTime
  status   InvoiceStatus @default(ISSUED)

  // Okres, którego dotyczy rachunek (puste dla pakietu przedpłaconego)
  periodStart DateTime?
  periodEnd   DateTime?

  totalAmount Decimal @db.Decimal(10, 2)
  note        String?

  // Dane wystawcy skopiowane w chwili wystawienia — wydruk ma być niezmienny.
  //
  // `sellerSnapshot` to sklejony blok adresowy do nagłówka. Nie da się z niego
  // wyjąć pojedynczych pól, więc stopka wydruku brała je z BIEŻĄCYCH ustawień
  // i zmiana konta bankowego zmieniała wygląd wystawionego dokumentu
  // (audyt zewnętrzny, F19). Stąd trzy osobne kopie poniżej.
  sellerSnapshot String? @db.Text
  buyerSnapshot  String? @db.Text

  /// Numer konta z chwili wystawienia — instrukcja przelewu musi zostać ta sama.
  bankAccountSnapshot String? @db.Text
  /// Adnotacja podatkowa z chwili wystawienia.
  taxNoteSnapshot     String? @db.Text
  /// Stopka z chwili wystawienia.
  footerSnapshot      String? @db.Text

  items    InvoiceItem[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([numberYear, numberMonth, sequence])
  @@index([studentId])
  @@map("invoices")
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(10, 2)
  amount      Decimal @db.Decimal(10, 2)

  // Powiązanie z lekcją pilnuje, by ta sama lekcja nie trafiła na dwa rachunki
  lessonId String? @unique
  lesson   Lesson? @relation(fields: [lessonId], references: [id])

  @@index([invoiceId])
  @@map("invoice_items")
}

enum PaymentMethod {
  TRANSFER
  CASH
  BLIK
  OTHER
}

model Payment {
  id String @id @default(cuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  // Wpłata bez rachunku to przedpłata na poczet przyszłych lekcji
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  amount Decimal       @db.Decimal(10, 2)
  paidAt DateTime      @default(now())
  method PaymentMethod @default(TRANSFER)
  note   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([invoiceId])
  @@map("payments")
}

// Dane wystawcy na rachunku + domyślny termin płatności. Jeden rekord.
model BillingSettings {
  id              String   @id @default("singleton")
  sellerName      String   @default("")
  sellerAddress   String   @default("")
  sellerContact   String   @default("")
  sellerTaxNote   String   @default("Sprzedaż nieewidencjonowana — działalność nierejestrowana.")
  bankAccount     String   @default("")
  paymentTermDays Int      @default(7)
  invoiceFooter   String   @default("")
  updatedAt       DateTime @updatedAt

  @@map("billing_settings")
}

// ---------- DZIAŁALNOŚĆ NIEREJESTROWANA — LIMIT I STATYSTYKI (Faza 3) ----------

enum NdgPeriodMode {
  MONTHLY // limit rozliczany miesiąc po miesiącu
  QUARTERLY // limit rozliczany kwartalnie
}

enum NdgRevenueBasis {
  INVOICED // przychód należny — liczony z wystawionych rachunków
  PAID // ujęcie kasowe — liczone z wpłat
}

/// Ustawienia modułu NDG. Jeden rekord.
/// `enabled = false` wyłącza pilnowanie limitu (np. po założeniu firmy) —
/// moduł zostaje wtedy jako czyste statystyki finansowe.
model NdgSettings {
  id                   String          @id @default("singleton")
  enabled              Boolean         @default(true)
  mode                 NdgPeriodMode   @default(QUARTERLY)
  revenueBasis         NdgRevenueBasis @default(INVOICED)
  /// Próg ostrzeżenia w procentach limitu okresu.
  warnThresholdPercent Int             @default(90)
  /// Data przejścia na działalność rejestrowaną — dokumentuje, od kiedy limitu nie liczymy.
  businessStartedAt    DateTime?
  note                 String          @default("")
  updatedAt            DateTime        @updatedAt

  @@map("ndg_settings")
}

/// Limit miesięczny obowiązujący od podanej daty. Trzymamy historię, bo kwota
/// zmienia się razem z minimalnym wynagrodzeniem — limit kwartału to suma
/// limitów jego miesięcy.
///
/// UWAGA: kwoty wprowadza administrator. Aplikacja nie zna przepisów i nie
/// jest doradcą podatkowym — wartości potwierdź z księgowym.
model NdgMonthlyLimit {
  id        String   @id @default(cuid())
  validFrom DateTime @unique
  amount    Decimal  @db.Decimal(10, 2)
  note      String   @default("")
  createdAt DateTime @default(now())

  @@map("ndg_monthly_limits")
}

// ---------- WIADOMOŚCI (admin -> nauczyciele) ----------

/// Wiadomość wysyłana przez administratora: do jednego nauczyciela albo do
/// wszystkich. Stan przeczytania trzyma `MessageRecipient`, osobno dla każdego
/// odbiorcy — dzięki temu wysyłka zbiorcza działa tak samo jak pojedyncza.
model Message {
  id String @id @default(cuid())

  senderId String
  sender   User   @relation(fields: [senderId], references: [id])

  subject   String
  body      String  @db.Text
  /// true = wysłana do wszystkich aktywnych nauczycieli w chwili wysyłki
  broadcast Boolean @default(false)

  createdAt DateTime @default(now())

  recipients MessageRecipient[]

  @@index([createdAt])
  @@map("messages")
}

model MessageRecipient {
  id String @id @default(cuid())

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  readAt DateTime?

  @@unique([messageId, teacherId])
  @@index([teacherId, readAt])
  @@map("message_recipients")
}

// ---------- WYPŁATY DLA NAUCZYCIELI ----------

/// Zarejestrowana wypłata. Lekcje rozliczone tą wypłatą wskazują na nią
/// przez `Lesson.teacherPayoutId`, więc „ile się należy” liczy tylko te,
/// które jeszcze do żadnej nie trafiły.
model Payout {
  id        String         @id @default(cuid())
  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  amount Decimal  @db.Decimal(10, 2)
  paidAt DateTime @default(now())

  paidById String
  paidBy   User   @relation(fields: [paidById], references: [id])

  note String?

  createdAt DateTime @default(now())

  lessons Lesson[]

  @@index([teacherId, paidAt])
  @@map("payouts")
}

// ---------- PRZYPOMNIENIA ----------

enum ReminderChannel {
  NONE
  TELEGRAM
  SMS
}

enum ReminderStatus {
  SENT
  FAILED
}

/// Ślad po wysłanym przypomnieniu — także nieudanym, żeby cron nie próbował
/// w kółko, a admin miał co sprawdzić.
model ReminderLog {
  id       String @id @default(cuid())
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  channel ReminderChannel
  status  ReminderStatus
  sentAt  DateTime        @default(now())
  error   String?

  /// Jedno przypomnienie na lekcję, niezależnie od kanału.
  @@unique([lessonId])
  @@index([sentAt])
  @@map("reminder_logs")
}

/// Jednorazowy kod zapasowy do drugiego składnika.
///
/// Bez tego utrata telefonu zamyka właścicielowi dostęp do własnego CRM-a na
/// zawsze. Kody trzymamy jako HASZE — w bazie nie ma z czego ich odtworzyć.
model TwoFactorRecoveryCode {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  codeHash String
  usedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("two_factor_recovery_codes")
}

// ---------- DZIENNIK ZDARZEŃ BEZPIECZEŃSTWA ----------

enum SecurityEventType {
  LOGIN_OK
  LOGIN_FAILED
  LOGIN_BLOCKED // próba na koncie będącym w blokadzie
  ACCOUNT_LOCKED // przekroczony próg nieudanych prób
  PASSWORD_CHANGED // właściciel zmienił swoje hasło
  PASSWORD_RESET // admin ustawił hasło nauczycielowi
  TEACHER_DEACTIVATED
  TOTP_ENABLED
  TOTP_DISABLED
  TOTP_FAILED // zły kod drugiego składnika
  RECOVERY_CODE_USED
  STUDENT_ANONYMIZED
  STUDENT_EXPORTED
}

/// Ślad po zdarzeniach logowania i zmianach haseł.
///
/// Bez tego nie da się zauważyć, że ktoś systematycznie próbuje się dostać —
/// blokada konta działa po cichu. Dziennik czyta wyłącznie admin.
///
/// NIE zapisujemy tu haseł ani tokenów. Adres IP trzymamy jako dane potrzebne
/// do wykrycia nadużycia i kasujemy razem ze starymi wpisami.
model SecurityEvent {
  id   String            @id @default(cuid())
  type SecurityEventType

  /// Konto, którego dotyczy zdarzenie — `null`, gdy adres nie istnieje.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Adres z próby logowania. Trzymamy go osobno, bo przy nieistniejącym
  /// koncie nie ma do czego się podpiąć.
  email String?

  ip        String?
  userAgent String?
  detail    String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
  @@map("security_events")
}

/// Jednorazowy token do połączenia konta Telegram ucznia z botem.
model TelegramLinkToken {
  id        String  @id @default(cuid())
  token     String  @unique
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([studentId])
  @@map("telegram_link_tokens")
}

