# Postgres — lokalny albo darmowy instance na Supabase/Neon
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/korkigo?schema=public"

# Sekret do podpisywania ciasteczka sesji (min. 32 znaki).
# Wygeneruj: openssl rand -base64 32
AUTH_SECRET="zmien-mnie-na-losowy-sekret-min-32-znaki"

# Konto administratora zakładane przez `npm run db:seed`
SEED_ADMIN_EMAIL="admin@korkigo.pl"
SEED_ADMIN_PASSWORD="zmien-to-haslo"
